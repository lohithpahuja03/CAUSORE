# CAUSORE Backend Configuration

PROJECT_NAME=CAUSORE
ENVIRONMENT=development
API_V1_STR=/api
DEBUG=True

# Database (PostgreSQL URL; fallback to sqlite+aiosqlite:///backend/causore.db for dev)
DATABASE_URL=sqlite+aiosqlite:///backend/causore.db

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_SIZE_MB=50

# Optional AI LLM Provider Configuration
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
